  "historicalProblem": "代数方程和几何图形之间有什么关系？能否用数字描述位置？",
  "narrative": {
    "hook": "据说笛卡尔是在床上观察苍蝇爬行时，想到了用数字描述位置的方法。",
    "context": "17 世纪，代数和几何是两个独立的数学分支。笛卡尔在 1637 年出版的《方法论》附录中，提出了将两者统一的方法。",
    "problem": "如何用代数方法研究几何问题？如何用数字精确描述空间中的位置？",
    "discovery": "笛卡尔引入了坐标系的概念：用两个数（坐标）来确定平面上的一个点。这样，几何图形可以用代数方程表示，代数方程也可以用几何图形可视化。",
    "credibility": "B",
    "sources": ["Descartes, La Géométrie", "Boyer, A History of Mathematics"]
  },
  "keyFigures": [
    {
      "name": "笛卡尔",
      "lifespan": "1596 - 1650",
      "bio": "法国数学家、哲学家。解析几何的创始人，提出了'我思故我在'的哲学命题。",
      "credibility": "A"
    }
  ],
  "mathConcepts": [
    {
      "name": "坐标系",
      "definition": "用有序数对确定平面上点的位置的系统。",
      "category": "geometry",
      "educationLevel": "middle-school"
    },
    {
      "name": "函数图像",
      "definition": "函数关系在坐标系中的几何表示。",
      "category": "algebra",
      "educationLevel": "high-school"
    },
    {
      "name": "解析几何",
      "definition": "用代数方法研究几何问题的数学分支。",
      "category": "geometry",
      "educationLevel": "high-school"
    }
  ],
  "learningObjectives": [
